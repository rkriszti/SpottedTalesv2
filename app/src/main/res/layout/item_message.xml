<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <ImageView
        android:id="@+id/chat_profilpic"
        android:layout_width="46dp"
        android:layout_height="48dp"
        android:layout_alignParentStart="true"
        android:background="@android:color/transparent"
        android:src="@drawable/default_profile"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/text_user"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/chat_profilpic"
        android:layout_marginStart="8dp"
        android:text="user@email.com"
        android:textColor="#888888"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/text_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/text_user"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:layout_toEndOf="@id/chat_profilpic"
        android:background="@drawable/rounded_button"
        android:maxWidth="280dp"
        android:padding="12dp"
        android:text="Üzenet szövege"
        android:textColor="#000000"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/chat_delete"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:clickable="true"
        android:src="@drawable/ic_delete"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/chat_egyeb_start"
        android:layout_width="54dp"
        android:layout_marginTop="15dp"
        android:layout_height="51dp"
        android:layout_marginStart="3dp"
        android:layout_toEndOf="@id/text_message"
        app:srcCompat="@drawable/ic_egyeb" />

    <ImageView
        android:id="@+id/chat_egyeb_hide"
        android:layout_width="54dp"
        android:layout_marginTop="15dp"
        android:layout_height="51dp"
        android:layout_marginStart="3dp"
        android:visibility="gone"
        android:layout_toEndOf="@id/text_message"
        app:srcCompat="@drawable/ic_egyeb" />

</RelativeLayout>